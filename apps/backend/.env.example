# ==========================================
# CosRent Backend Environment Configuration
# ==========================================

# Application Environment & Port
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password_example
DB_DATABASE=cosrent_db
DB_SYNCHRONIZE=false

# Authentication & JWT Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_example

# Rate Limiting (Throttler v5+: TTL tính bằng mili-giây ms)
# 60000 ms = 1 phút
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# CORS Allowed Origins (ngăn chặn truy cập trái phép)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

